@model List<ApiPost>

<h1>API Posts</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Post ID</th>
            <th>Post Title</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var post in Model)
    {
        <tr>
            <td class="post-id">@post.Id</td>
            <td class="post-title">
                @switch (post.Id)
                {
                    case 1:
                        @("Hospital Appointment")
                        break;
                    case 2:
                        @("Doctor Information")
                        break;
                    case 3:
                        @("Patient Registration")
                        break;
                    default:
                        @post.Title
                        break;
                }
            </td>
        </tr>
    }
</tbody>
</table>

<a asp-action="Index">Back to Home</a>